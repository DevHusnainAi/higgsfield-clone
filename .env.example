# Copy to .env.local and fill in. Leave the Supabase vars empty to run fully local (simulated renders).

# Supabase -> Project Settings -> API (publishable key is safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Hugging Face -> Settings -> Access Tokens (fine-grained, "Make calls to Inference Providers")
HF_TOKEN=
# Optional: fal.ai key. FLUX and Wan then call fal directly (billed to fal) instead of through HF credits.
FAL_KEY=

# Free tier: images for users without their own key render on Cloudflare Workers AI (SDXL Lightning).
# Cloudflare dashboard -> Workers AI for the account ID; API Tokens -> "Workers AI" template for the token.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional: lets signed-in users save their own HF / fal keys in Settings (encrypted at rest with this key).
# 32 random bytes, base64: openssl rand -base64 32. Server only. Changing it makes saved keys unreadable.
# BYOK_ENCRYPTION_KEY=

# On a provider 402 (billing limit), complete runs with a labelled stock asset instead of failing. "off" = fail + refund.
# DEMO_FALLBACK=off

# Offer "Enter a code instead" on the sign-in screen. Turn on only after adding {{ .Token }} to the Supabase
# Magic Link and Change Email Address templates; the default templates send the link alone.
# NEXT_PUBLIC_EMAIL_CODES=on
